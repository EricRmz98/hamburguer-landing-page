---
import MiniGame from '../components/MiniGame.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Hamburguesas">
  <!-- Hero pendiente de definir (etapa 01 del plan). -->
  <section class="flex min-h-screen flex-col items-center justify-center gap-4 px-6 text-center">
    <h1 data-reveal class="text-6xl font-bold tracking-tight md:text-8xl">Hamburguesas</h1>
    <p data-reveal class="text-lg text-neutral-400">Hero pendiente · baja para jugar</p>
  </section>

  <MiniGame />

  <section id="pedir" class="flex min-h-[50vh] items-center justify-center px-6">
    <p class="text-center text-xl text-neutral-400">Destino de «Pídela de verdad» pendiente.</p>
  </section>
</Layout>
