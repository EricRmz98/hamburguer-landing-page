---
// Segunda sección: minijuego de hamburguesas.
// El juego se carga cuando la sección se acerca a la vista.
---

<!-- Sin relleno lateral en móvil: el escenario vertical (180 px) necesita 360 px para escalar a 2×. -->
<section id="minijuego" class="flex min-h-screen flex-col items-center justify-center gap-6 py-12 sm:px-4" aria-labelledby="mg-title">
  <h2 id="mg-title" class="px-4 text-center text-3xl font-bold tracking-tight md:text-5xl">Arma la hamburguesa</h2>
  <div class="mg-root" data-minigame>
    <div class="mg-fallback">
      <p>Cocina la carne y arma la orden del cliente.</p>
      <a href="#pedir">Pídela de verdad</a>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-minigame]');
  if (root) {
    const loader = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        loader.disconnect();
        import('../game/main.ts').then(({ mountMiniGame }) => mountMiniGame(root));
      },
      { rootMargin: '400px 0px' },
    );
    loader.observe(root);
  }
</script>

<style is:global>
  /* Colores de interfaz tomados de Endesga 32 (los sprites tienen los suyos en src/game/sprites). */
  .mg-root {
    position: relative;
    display: flex;
    width: 100%;
    justify-content: center;
  }
  .mg-fallback {
    display: grid;
    gap: 1rem;
    justify-items: center;
    color: #c0cbdc;
  }
  .mg-fallback a,
  .mg-overlay-btn {
    border-radius: 0.25em;
    background: #feae34;
    color: #181425;
    font-weight: 700;
    text-decoration: none;
  }
  .mg-fallback a {
    padding: 0.6rem 1.2rem;
  }

  .mg-stage {
    --s: 2;
    position: relative;
    overflow: hidden;
    border-radius: calc(var(--s) * 2px);
    background: #262b44;
    color: #fff;
    /* Pixelify Sans: pixelada pero sin cuadrícula estricta, así que se escala libre. El texto va a
       «medio pixel»: su trazo (1/10 del tamaño) mide 0.6 pixeles del juego y las mayúsculas, 3.8. */
    --texto: calc(var(--s) * 6px);
    --titulo: calc(var(--s) * 12px);
    font-family: 'Pixelify Sans', ui-monospace, monospace;
    font-size: var(--texto);
    font-weight: 500;
    font-synthesis: none;
    line-height: calc(var(--s) * 6.5px); /* deja aire a los acentos (0.85 del tamaño) */
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .mg-stage > * {
    position: absolute;
    box-sizing: border-box;
  }
  .mg-stage [hidden] {
    display: none !important;
  }

  /* Un sprite es un elemento cuyo fondo es un recorte del atlas (ver bake.ts → atlasStyle). */
  .mg-sprite {
    position: absolute;
    background-repeat: no-repeat;
    image-rendering: pixelated;
    pointer-events: none;
  }
  .mg-wall {
    inset: 0;
    background-repeat: repeat;
    image-rendering: pixelated;
  }
  /* Barra en 3/4: borde trasero claro, superficie de tablones y el frente oscuro abajo. */
  .mg-counter {
    border-top: calc(var(--s) * 2px) solid #c28569;
    border-bottom: calc(var(--s) * 5px) solid #733e39;
    background-color: #b86f50;
    background-repeat: repeat;
    image-rendering: pixelated;
    box-shadow: inset 0 calc(var(--s) * 2px) 0 rgb(24 20 37 / 0.35), inset 0 calc(var(--s) * -1px) 0 #3e2731;
  }

  .mg-btn {
    padding: 0;
    border: 0;
    background: transparent;
    font: inherit;
    cursor: pointer;
    transition: opacity 0.15s, filter 0.15s;
  }
  .mg-btn:active {
    filter: brightness(0.85);
  }
  .mg-btn:hover {
    filter: brightness(1.12);
  }
  .mg-stage button:focus-visible,
  .mg-stage a:focus-visible {
    outline: calc(var(--s) * 1px) solid #fff;
    outline-offset: calc(var(--s) * 0.5px);
  }
  .mg-btn.is-dim {
    opacity: 0.3;
    filter: grayscale(0.7);
  }
  /* Etiqueta de cinta masking sobre el frente de la bandeja. */
  .mg-tape {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(234 212 170 / 0.95);
    color: #3e2731;
    font: 600 var(--texto) / 1 'Pixelify Sans', ui-monospace, monospace;
    white-space: nowrap;
    clip-path: polygon(0 0, 100% 0, 97% 25%, 100% 50%, 97% 75%, 100% 100%, 0 100%, 3% 75%, 0 50%, 3% 25%);
    pointer-events: none; /* la inclinación de cada cinta la pone la vista */
  }

  .mg-hud {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--texto);
    text-shadow: 0 calc(var(--s) * 0.5px) 0 #181425;
  }
  .mg-lives {
    display: flex;
    gap: calc(var(--s) * 1px);
    align-items: center;
  }
  .mg-lives .mg-sprite {
    position: static;
    display: inline-block;
  }
  .mg-pause {
    padding: 0;
    border: 0;
    border-radius: calc(var(--s) * 1px);
    background: rgb(255 255 255 / 0.12);
    color: #fff;
    font: inherit;
    font-size: calc(var(--s) * 4.5px);
    line-height: 1;
    cursor: pointer;
  }
  .mg-pause:hover {
    background: rgb(255 255 255 / 0.25);
  }

  .mg-ticket {
    display: flex;
    flex-direction: column;
    padding: calc(var(--s) * 1px);
    border-radius: calc(var(--s) * 1px);
    background: #ead4aa;
    color: #181425;
    box-shadow: calc(var(--s) * 1px) calc(var(--s) * 1px) 0 rgb(24 20 37 / 0.45);
  }
  .mg-ticket-name {
    height: calc(var(--s) * 7px);
    font-size: var(--texto);
    text-align: center;
  }
  .mg-ticket-rows {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: flex-end;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mg-ticket-row {
    display: flex;
    align-items: center;
    gap: calc(var(--s) * 1px);
    padding: 0 calc(var(--s) * 1px);
    font-size: var(--texto);
    white-space: nowrap;
  }
  .mg-ticket-row.is-done {
    opacity: 0.35;
    text-decoration: line-through;
  }
  .mg-ticket-row.is-next {
    background: #fee761;
    outline: calc(var(--s) * 0.5px) solid #e43b44;
  }
  .mg-swatch {
    flex: none;
    width: calc(var(--s) * 4px);
    height: calc(var(--s) * 3px);
    border: calc(var(--s) * 0.25px) solid rgb(24 20 37 / 0.5);
  }

  .mg-customer.is-away {
    opacity: 0;
  }
  .mg-patience {
    overflow: hidden;
    border-radius: calc(var(--s) * 1px);
    background: rgb(24 20 37 / 0.6);
  }
  .mg-patience-bar {
    height: 100%;
    background: #63c74d;
  }
  .mg-patience-bar.is-low {
    background: #ff0044;
  }
  .mg-stack {
    inset: 0;
    pointer-events: none;
  }

  /* Basura con carne quemada: un contorno pixelado rojo alrededor de todo el hueco, sin recolorearlo.
     Cada drop-shadow sin desenfoque copia la silueta un pixel del juego hacia un lado; encadenados,
     dibujan un contorno de 1 pixel. Parpadea a saltos, sin degradados: contorno y contorno doble. */
  .mg-basura.is-alert .mg-sprite {
    --px: calc(var(--s) * 1px);
    --aro: drop-shadow(var(--px) 0 0 #ff0044) drop-shadow(calc(var(--px) * -1) 0 0 #ff0044)
      drop-shadow(0 var(--px) 0 #ff0044) drop-shadow(0 calc(var(--px) * -1) 0 #ff0044);
    --aro-2: drop-shadow(var(--px) 0 0 #a22633) drop-shadow(calc(var(--px) * -1) 0 0 #a22633)
      drop-shadow(0 var(--px) 0 #a22633) drop-shadow(0 calc(var(--px) * -1) 0 #a22633);
    filter: var(--aro);
    animation: mg-glow 0.8s steps(1) infinite;
  }
  @keyframes mg-glow {
    50% {
      filter: var(--aro) var(--aro-2);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mg-basura.is-alert .mg-sprite {
      animation: none;
    }
  }

  /* La plancha es un sprite; cada lugar es una zona transparente sobre la placa. */
  .mg-slot {
    position: absolute;
    border-radius: calc(var(--s) * 1px);
  }
  /* Lugar apagado: solo se oscurece la zona de la placa que se calienta (filas 6 a 24 del sprite de
     la plancha; el lugar empieza 2 filas más abajo), no la salpicadera ni el panel con la perilla. */
  .mg-slot.is-off {
    pointer-events: none;
  }
  .mg-slot.is-off::before {
    position: absolute;
    top: calc(var(--s) * 4px);
    right: 0;
    left: 0;
    height: calc(var(--s) * 19px);
    background: rgb(24 20 37 / 0.6);
    content: '';
  }

  /* Indicador de cocción: la pista muestra las zonas y el relleno avanza con el color de la zona actual. */
  .mg-gauge {
    position: absolute;
    right: calc(var(--s) * 2px);
    bottom: calc(var(--s) * 2.5px);
    left: calc(var(--s) * 2px);
    height: calc(var(--s) * 3px);
    overflow: hidden;
    border-radius: calc(var(--s) * 1px);
    background: linear-gradient(
      to right,
      rgb(254 231 97 / 0.3) 0 var(--g1),
      rgb(99 199 77 / 0.3) var(--g1) var(--g2),
      rgb(255 0 68 / 0.3) var(--g2)
    );
  }
  .mg-gauge-fill {
    height: 100%;
    background: #fee761;
  }
  .mg-slot[data-state='perfecta'] .mg-gauge-fill {
    background: #63c74d;
  }
  .mg-slot[data-state='aviso'] .mg-gauge-fill,
  .mg-slot[data-state='quemada'] .mg-gauge-fill {
    background: #ff0044;
  }
  .mg-slot[data-state='aviso'] .mg-gauge {
    animation: mg-signal 0.4s steps(2, jump-none) infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .mg-slot[data-state='aviso'] .mg-gauge {
      animation-duration: 1.2s;
    }
  }

  .mg-bubble {
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: calc(var(--s) * 2px);
    align-items: flex-start;
    padding: calc(var(--s) * 2px) calc(var(--s) * 3px);
    border-radius: calc(var(--s) * 2px);
    background: #ead4aa;
    color: #181425;
    font-size: var(--texto);
    box-shadow: 0 calc(var(--s) * 1px) 0 rgb(24 20 37 / 0.5);
  }
  .mg-bubble-text {
    margin: 0;
  }
  .mg-ok {
    padding: calc(var(--s) * 1px) calc(var(--s) * 3px);
    border: 0;
    border-radius: calc(var(--s) * 1px);
    background: #e43b44;
    color: #fff;
    font: inherit;
    cursor: pointer;
  }
  .mg-arrow {
    z-index: 3;
  }
  .mg-toast {
    z-index: 4;
    top: calc(var(--s) * 16px);
    left: 50%;
    padding: calc(var(--s) * 1.5px) calc(var(--s) * 3px);
    border-radius: calc(var(--s) * 1px);
    background: rgb(24 20 37 / 0.85);
    font-size: var(--texto);
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-50%);
    transition: opacity 0.2s;
    pointer-events: none;
  }
  .mg-toast.is-on {
    opacity: 1;
  }

  .mg-overlay {
    z-index: 5;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: calc(var(--s) * 3px);
    align-items: center;
    justify-content: center;
    padding: calc(var(--s) * 10px);
    background: rgb(24 20 37 / 0.82);
    text-align: center;
  }
  .mg-overlay-title {
    margin: 0;
    font-size: var(--titulo);
    font-weight: 700;
    line-height: calc(var(--s) * 11px);
  }
  .mg-overlay-text {
    max-width: calc(var(--s) * 160px);
    margin: 0;
    font-size: var(--texto);
  }
  .mg-overlay-btn {
    padding: calc(var(--s) * 2px) calc(var(--s) * 6px);
    border: 0;
    font: inherit;
    cursor: pointer;
  }
  .mg-overlay-btn.is-secondary {
    background: transparent;
    color: #feae34;
    text-decoration: underline;
  }

  .mg-live {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @keyframes mg-signal {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.15;
    }
  }

  .mg-debug {
    position: fixed;
    right: 12px;
    bottom: 12px;
    z-index: 50;
    width: min(300px, calc(100vw - 24px));
    max-height: 80vh;
    overflow: auto;
    padding: 8px 12px;
    border: 1px solid #444;
    border-radius: 8px;
    background: rgb(17 17 17 / 0.94);
    color: #eee;
    font: 12px/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .mg-debug summary {
    cursor: pointer;
    font-weight: 700;
  }
  .mg-debug-row {
    display: grid;
    gap: 2px;
    margin-top: 8px;
  }
  .mg-debug-check {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .mg-debug-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }
  .mg-debug-actions input {
    width: 4em;
  }
  .mg-debug button {
    padding: 2px 8px;
    border: 1px solid #666;
    border-radius: 4px;
    background: #2a2a2a;
    color: #eee;
    cursor: pointer;
  }
  .mg-debug-info {
    margin: 10px 0 0;
    white-space: pre-wrap;
    color: #9fd;
  }
</style>
