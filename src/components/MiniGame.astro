---
// Segunda sección: minijuego de hamburguesas.
// El juego se carga cuando la sección se acerca a la vista.
---

<!-- Sin relleno lateral en móvil: el escenario vertical (180 px) necesita 360 px para escalar a 2×. -->
<section id="minijuego" class="flex min-h-screen flex-col items-center justify-center gap-6 py-12 sm:px-4" aria-labelledby="mg-title">
  <h2 id="mg-title" class="px-4 text-center text-3xl font-bold tracking-tight md:text-5xl">Arma la hamburguesa</h2>
  <div class="mg-root" data-minigame>
    <div class="mg-fallback">
      <p>Cocina la carne y arma la orden del cliente.</p>
      <a href="#pedir">Pídela de verdad</a>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-minigame]');
  if (root) {
    const loader = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        loader.disconnect();
        import('../game/main.ts').then(({ mountMiniGame }) => mountMiniGame(root));
      },
      { rootMargin: '400px 0px' },
    );
    loader.observe(root);
  }
</script>

<style is:global>
  /* Colores de interfaz tomados de Endesga 64 (los sprites tienen los suyos en src/game/sprites). */
  .mg-root {
    position: relative;
    display: flex;
    width: 100%;
    justify-content: center;
  }
  .mg-fallback {
    display: grid;
    gap: 1rem;
    justify-items: center;
    color: #c7cfdd;
  }
  .mg-fallback a,
  .mg-overlay-btn {
    border-radius: 0.25em;
    background: #ffa214;
    color: #131313;
    font-weight: 700;
    text-decoration: none;
  }
  .mg-fallback a {
    padding: 0.6rem 1.2rem;
  }

  .mg-stage {
    --s: 2;
    position: relative;
    overflow: hidden;
    border-radius: calc(var(--s) * 2px);
    background: #2a2f4e;
    color: #fff;
    /* Chakra Petch conserva las formas cuadradas del arcade con trazos limpios. */
    --texto: calc(var(--s) * 6px);
    --titulo: calc(var(--s) * 12px);
    font-family: 'Chakra Petch', sans-serif;
    font-size: var(--texto);
    font-weight: 500;
    font-synthesis: none;
    line-height: calc(var(--s) * 6.5px); /* deja aire a los acentos */
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .mg-stage > * {
    position: absolute;
    box-sizing: border-box;
  }
  .mg-stage [hidden] {
    display: none !important;
  }

  /* Un sprite es un elemento cuyo fondo es un recorte del atlas (ver bake.ts → atlasStyle). */
  .mg-sprite {
    position: absolute;
    background-repeat: no-repeat;
    image-rendering: pixelated;
    pointer-events: none;
  }
  /* Escenas nativas del atlas: composición propia por orientación, sin estirar ni repetir. */
  .mg-wall,
  .mg-counter {
    background-repeat: no-repeat;
    image-rendering: pixelated;
    pointer-events: none;
  }

  .mg-btn {
    padding: 0;
    border: 0;
    background: transparent;
    font: inherit;
    cursor: pointer;
    transition: opacity 0.15s, filter 0.15s;
  }
  .mg-btn:active {
    filter: brightness(0.85);
  }
  .mg-stage button:focus-visible,
  .mg-stage a:focus-visible {
    outline: calc(var(--s) * 1px) solid #fff;
    outline-offset: calc(var(--s) * 0.5px);
  }
  .mg-btn.is-dim {
    opacity: 0.3;
    filter: grayscale(0.7);
  }
  /* Etiqueta de cinta masking sobre el frente de la bandeja. */
  .mg-tape {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(249 230 207 / 0.95);
    color: #391f21;
    font: 600 var(--texto) / 1 'Chakra Petch', sans-serif;
    white-space: nowrap;
    clip-path: polygon(0 0, 100% 0, 97% 25%, 100% 50%, 97% 75%, 100% 100%, 0 100%, 3% 75%, 0 50%, 3% 25%);
    pointer-events: none; /* la inclinación de cada cinta la pone la vista */
  }

  /* Marcador arcade central: vidas, clientes y récord. Pausa es independiente. */
  .mg-hud,
  .mg-pause-icon {
    border: calc(var(--s) * 1px) solid #f9e6cf;
    background: #571c27;
    color: #f9e6cf;
    box-shadow: 0 0 0 calc(var(--s) * 1px) #391f21,
      inset 0 calc(var(--s) * 1px) 0 #891e2b,
      0 calc(var(--s) * 2px) 0 #391f21;
  }
  .mg-hud {
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(var(--s) * 4px);
    padding: 0 calc(var(--s) * 4px);
    font-size: calc(var(--s) * 7px);
    font-weight: 700;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .mg-lives {
    display: flex;
    flex: none;
    gap: calc(var(--s) * 1px);
    align-items: center;
  }
  .mg-lives .mg-sprite {
    position: static;
    display: inline-block;
  }
  .mg-score,
  .mg-best {
    border-left: calc(var(--s) * 1px) solid #edab50;
    padding-left: calc(var(--s) * 5px);
  }
  .mg-pause {
    position: absolute;
    z-index: 2;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: #f9e6cf;
    cursor: pointer;
    touch-action: manipulation;
  }
  .mg-pause-icon {
    position: relative;
    display: block;
    width: calc(var(--s) * 14px);
    height: calc(var(--s) * 14px);
  }
  .mg-pause-icon::before,
  .mg-pause-icon::after {
    position: absolute;
    top: calc(var(--s) * 3px);
    bottom: calc(var(--s) * 3px);
    width: calc(var(--s) * 2px);
    background: currentColor;
    content: '';
  }
  .mg-pause-icon::before { left: calc(var(--s) * 3px); }
  .mg-pause-icon::after { right: calc(var(--s) * 3px); }
  /* Botón independiente en la esquina: solo el icono recibe feedback visual. */
  .mg-pause:active .mg-pause-icon { background: #391f21; color: #ffc825; }
  .mg-stage .mg-pause:focus-visible { outline: none; }
  .mg-pause:focus-visible .mg-pause-icon {
    outline: calc(var(--s) * 1px) solid #fff;
    outline-offset: calc(var(--s) * 2px);
  }
  .mg-stage[data-layout='vertical'] .mg-hud {
    gap: calc(var(--s) * 3px);
    font-size: var(--texto);
  }
  .mg-stage[data-layout='vertical'] .mg-pause-icon {
    width: calc(var(--s) * 16px);
    height: calc(var(--s) * 16px);
  }
  .mg-stage[data-layout='vertical'] .mg-score,
  .mg-stage[data-layout='vertical'] .mg-best {
    padding-left: calc(var(--s) * 3px);
  }

  /* Papel corto sujeto al riel; los pasos se leen en el mismo orden del armado. */
  .mg-ticket {
    display: flex;
    flex-direction: column;
    padding: calc(var(--s) * 3px);
    border: calc(var(--s) * 1px) solid #391f21;
    background: #f9e6cf;
    color: #391f21;
    box-shadow: calc(var(--s) * 1px) calc(var(--s) * 2px) 0 #391f21;
    font-weight: 600;
  }
  .mg-ticket::before {
    position: absolute;
    top: calc(var(--s) * -4px);
    left: calc(var(--s) * -2px);
    right: calc(var(--s) * -2px);
    height: calc(var(--s) * 3px);
    border: calc(var(--s) * 1px) solid #424c6e;
    background: #c7cfdd;
    content: '';
  }
  .mg-ticket::after {
    position: absolute;
    top: calc(var(--s) * -6px);
    left: calc(50% - var(--s) * 3px);
    width: calc(var(--s) * 6px);
    height: calc(var(--s) * 7px);
    border: calc(var(--s) * 1px) solid #424c6e;
    background: #92a1b9;
    content: '';
  }
  .mg-ticket-name {
    flex: none;
    height: calc(var(--s) * 8px);
    margin-bottom: calc(var(--s) * 2px);
    border-bottom: calc(var(--s) * 1px) solid #edab50;
    font-size: var(--texto);
    font-weight: 700;
    text-align: center;
    white-space: nowrap;
  }
  .mg-ticket-rows {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mg-stage[data-layout='vertical'] .mg-ticket-name { font-size: calc(var(--s) * 5.5px); }
  .mg-ticket-row {
    display: flex;
    flex: none;
    align-items: center;
    gap: calc(var(--s) * 3px);
    padding: 0 calc(var(--s) * 1px);
    font-size: var(--texto);
    white-space: nowrap;
  }
  .mg-ticket-row.is-done { color: #131313; }
  .mg-ticket-check {
    position: relative;
    flex: none;
  }
  .mg-ticket-row.is-done .mg-ticket-label {
    text-decoration: line-through;
    text-decoration-color: #131313;
    text-decoration-thickness: calc(var(--s) * 1px);
  }
  .mg-ticket-row.is-next { background: #ffc825; font-weight: 700; }
  .mg-customer.is-away { opacity: 0; }
  /* Globo compacto del atlas: contador y barra, con curvas escalonadas. */
  .mg-patience {
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: calc(var(--s) * 3px);
    padding: calc(var(--s) * 3px) calc(var(--s) * 4px);
    color: #391f21;
    pointer-events: none;
  }
  .mg-patience-skin {
    top: 0;
    left: calc(var(--s) * -6px);
    filter: drop-shadow(calc(var(--s) * 1px) calc(var(--s) * 1px) 0 #391f21);
  }
  .mg-patience-head {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) calc(var(--s) * 4px);
    gap: calc(var(--s) * 3px);
    flex: none;
    align-items: center;
    justify-content: center;
    height: calc(var(--s) * 9px);
    width: calc(var(--s) * 44px);
    align-self: center;
  }
  .mg-patience-attention {
    position: relative;
    grid-column: 2;
    justify-self: center;
  }
  .mg-patience[data-mood='impaciente'][data-timed='true'] .mg-patience-attention {
    animation: mg-signal 1.6s steps(2, jump-none) infinite;
  }
  .mg-patience[data-mood='enojado'][data-timed='true'] .mg-patience-attention {
    animation: mg-signal 0.6s steps(2, jump-none) infinite;
  }
  .mg-stage:has(.mg-overlay:not([hidden])) .mg-patience-attention { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) {
    .mg-patience[data-timed='true'] .mg-patience-attention { animation: none; }
  }
  .mg-patience-time {
    text-align: left;
    font-size: calc(var(--s) * 7px);
    line-height: calc(var(--s) * 9px);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .mg-patience-track {
    position: relative;
    flex: none;
    align-self: center;
    width: calc(var(--s) * 44px);
    height: calc(var(--s) * 3px);
    background: #c7cfdd;
    color: #5ac54f;
  }
  .mg-patience-fill { width: 100%; height: 100%; background: currentColor; }
  .mg-patience[data-mood='impaciente'] .mg-patience-track { color: #ffc825; }
  .mg-patience[data-mood='enojado'] .mg-patience-track { color: #ff0040; }
  .mg-patience[data-mood='enojado'] .mg-patience-time { color: #891e2b; }
  .mg-stack {
    inset: 0;
    pointer-events: none;
  }

  /* La plancha es un sprite; cada lugar es una zona transparente sobre la placa. */
  .mg-slot {
    position: absolute;
    border-radius: calc(var(--s) * 1px);
  }
  /* Lugar apagado: solo se oscurece la zona de la placa que se calienta (filas 6 a 24 del sprite de
     la plancha; el lugar empieza 2 filas más abajo), no la salpicadera ni el panel con la perilla. */
  .mg-slot.is-off {
    pointer-events: none;
  }
  .mg-slot.is-off::before {
    position: absolute;
    top: calc(var(--s) * 4px);
    right: 0;
    left: 0;
    height: calc(var(--s) * 19px);
    background: rgb(19 19 19 / 0.6);
    content: '';
  }

  /* Barra continua compacta: las zonas permanecen fijas mientras avanza la iluminación. */
  .mg-gauge {
    position: absolute;
    z-index: 1;
    bottom: calc(var(--s) * 10px);
    left: calc(50% - var(--s) * 10px);
    display: flex;
    align-items: center;
    gap: calc(var(--s) * 1px);
    height: calc(var(--s) * 2px);
    color: #ffc825;
    pointer-events: none;
  }
  .mg-cooking-track {
    position: relative;
    width: calc(var(--s) * 20px);
    height: 100%;
    background: linear-gradient(to right,
      #8a4836 0 var(--cook-end),
      #134c4c var(--cook-end) var(--ready-end),
      #571c27 var(--ready-end) 100%);
    box-shadow: 0 calc(var(--s) * 1px) 0 #131313;
  }
  .mg-cooking-fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right,
      #ffc825 0 var(--cook-end),
      #5ac54f var(--cook-end) var(--ready-end),
      #ff0040 var(--ready-end) 100%);
  }
  .mg-gauge-signal {
    position: absolute;
    left: calc(var(--s) * 21px);
    top: calc(var(--s) * -1px);
  }
  .mg-slot[data-state='aviso'] .mg-gauge-signal {
    animation: mg-signal 0.8s steps(2, jump-none) infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .mg-slot[data-state='aviso'] .mg-gauge-signal { animation: none; }
  }
  @media (hover: hover) and (pointer: fine) {
    .mg-btn:hover { filter: brightness(1.12); }
    .mg-pause:hover .mg-pause-icon { background: #c42430; color: #ffc825; }
  }

  .mg-bubble {
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: calc(var(--s) * 2px);
    align-items: flex-start;
    padding: calc(var(--s) * 2px) calc(var(--s) * 3px);
    border-radius: calc(var(--s) * 2px);
    background: #f9e6cf;
    color: #131313;
    font-size: var(--texto);
    box-shadow: 0 calc(var(--s) * 1px) 0 rgb(19 19 19 / 0.5);
  }
  .mg-bubble-text {
    margin: 0;
  }
  .mg-ok {
    padding: calc(var(--s) * 1px) calc(var(--s) * 3px);
    border: 0;
    border-radius: calc(var(--s) * 1px);
    background: #ea323c;
    color: #fff;
    font: inherit;
    cursor: pointer;
  }
  .mg-arrow {
    z-index: 3;
  }
  .mg-toast {
    z-index: 4;
    top: calc(var(--s) * 35px);
    left: 50%;
    padding: calc(var(--s) * 1.5px) calc(var(--s) * 3px);
    border-radius: calc(var(--s) * 1px);
    background: rgb(19 19 19 / 0.85);
    font-size: var(--texto);
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-50%);
    transition: opacity 0.2s;
    pointer-events: none;
  }
  .mg-toast.is-on {
    opacity: 1;
  }

  .mg-overlay {
    z-index: 5;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: calc(var(--s) * 3px);
    align-items: center;
    justify-content: center;
    padding: calc(var(--s) * 10px);
    background: rgb(19 19 19 / 0.82);
    text-align: center;
  }
  .mg-overlay-title {
    margin: 0;
    font-size: var(--titulo);
    font-weight: 700;
    line-height: calc(var(--s) * 11px);
  }
  .mg-overlay-text {
    max-width: calc(var(--s) * 160px);
    margin: 0;
    font-size: var(--texto);
  }
  .mg-overlay-btn {
    padding: calc(var(--s) * 2px) calc(var(--s) * 6px);
    border: 0;
    font: inherit;
    cursor: pointer;
  }
  .mg-overlay-btn.is-secondary {
    background: transparent;
    color: #ffa214;
    text-decoration: underline;
  }

  .mg-live {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @keyframes mg-signal {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.15;
    }
  }

  .mg-debug {
    position: fixed;
    right: 12px;
    bottom: 12px;
    z-index: 50;
    width: min(300px, calc(100vw - 24px));
    max-height: 80vh;
    overflow: auto;
    padding: 8px 12px;
    border: 1px solid #424c6e;
    border-radius: 8px;
    background: rgb(19 19 19 / 0.94);
    color: #c7cfdd;
    font: 500 12px/1.4 'Chakra Petch', sans-serif;
  }
  .mg-debug summary {
    cursor: pointer;
    font-weight: 700;
  }
  .mg-debug-row {
    display: grid;
    gap: 2px;
    margin-top: 8px;
  }
  .mg-debug-check {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .mg-debug-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }
  .mg-debug-actions input {
    width: 4em;
  }
  .mg-debug button {
    padding: 2px 8px;
    border: 1px solid #657392;
    border-radius: 4px;
    background: #2a2f4e;
    color: #c7cfdd;
    cursor: pointer;
  }
  .mg-debug-info {
    margin: 10px 0 0;
    white-space: pre-wrap;
    color: #94fdff;
  }
</style>
